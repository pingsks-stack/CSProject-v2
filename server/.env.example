# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่เก็บใน git)

# ที่อยู่ MongoDB เช่น mongodb://localhost:27017/csproject หรือ mongodb+srv://... ของ Atlas
# ถ้าเว้นว่างไว้ ตอนพัฒนาจะเปิด MongoDB ในเครื่องให้อัตโนมัติ (เก็บข้อมูลที่ server/data/)
MONGODB_URI=

# กุญแจเซ็น token ล็อกอิน ต้องตั้งเป็นค่าสุ่มยาว ๆ บนเซิร์ฟเวอร์จริง
JWT_SECRET=change-me

PORT=4000

# true = คุกกี้ล็อกอินส่งเฉพาะ HTTPS (ค่าเริ่มต้นในโหมด production)
# ตั้งเป็น false ถ้าเปิดใช้ผ่าน http:// ภายในเครือข่ายโดยไม่มี HTTPS
COOKIE_SECURE=

# ที่อยู่เว็บที่ผู้ใช้เปิด (ใช้ทำลิงก์ในอีเมล) เช่น https://csproject.up.ac.th
APP_URL=

# ส่งอีเมล (แจ้งเตือน, เตือนกำหนดส่ง, ลืมรหัสผ่าน) ผ่าน SMTP — ไม่ตั้ง = ไม่ส่งอีเมล
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=อีเมล SMTP_PASS=App Password 16 ตัว
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CS Project <no-reply@up.ac.th>"

# เตือนกำหนดส่งอัตโนมัติ 3 วัน/1 วันก่อน และ 1 วันหลังเลยกำหนด (off = ปิด)
REMINDERS=on

# สำรองข้อมูล (npm run backup): โฟลเดอร์เก็บ (นับจากโฟลเดอร์โปรเจค) และจำนวนชุดที่เก็บไว้
BACKUP_DIR=backups
BACKUP_KEEP=14

# ไม่บังคับ: GitHub personal access token (fine-grained, อ่าน public repositories อย่างเดียวก็พอ)
# ไม่ตั้งก็ใช้ได้ แต่ GitHub จำกัด 60 ครั้ง/ชม. ต่อเซิร์ฟเวอร์
GITHUB_TOKEN=

# ไม่บังคับ: รหัสลับของ webhook ถ้าตั้งไว้ นิสิตเพิ่ม webhook ใน repository ให้ชี้มาที่
# https://<โดเมนของระบบ>/api/github/webhook (Content type: application/json, Secret: ค่านี้, เลือก Just the push event)
# แล้วงานจะอัปเดตทันทีที่ push (เซิร์ฟเวอร์ต้องเข้าถึงได้จากอินเทอร์เน็ต)
GITHUB_WEBHOOK_SECRET=
